# --- OmniSpace Stellar Forge configuration -------------------------------
# Copy to .env (in this folder) and fill in.

# AI-generated star systems need ONE of:
#   * "Sign in with ChatGPT" on the title screen (uses your ChatGPT Plus/Pro plan), or
#   * an OpenAI Platform API key (billed separately at https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# auto (default: API key if set, otherwise ChatGPT sign-in) | chatgpt | api_key
OMNISPACE_AUTH=auto

# Optional: model used by the Stellar Forge agent. Leave blank for the
# OpenAI Agents SDK default. Any tool-calling model works, e.g. gpt-5.4-mini.
OMNISPACE_MODEL=

# Optional: reasoning effort for reasoning models (none | low | medium | high).
OMNISPACE_REASONING=

# Optional: openai (default) | scripted (offline demo agent, no API calls) | off
OMNISPACE_AI=openai

# Optional: use Chat Completions instead of the Responses API so OPENAI_BASE_URL
# can point at an OpenAI-compatible server (Ollama, LM Studio, vLLM...).
# OMNISPACE_API=chat
# OPENAI_BASE_URL=http://localhost:11434/v1

# Optional: seconds before a generation falls back to the procedural generator.
OMNISPACE_TIMEOUT=240
