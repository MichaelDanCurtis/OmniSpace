// Simplex noise (Ashima/Gustavson) as HLSL for Custom material nodes.
float3 mod289(float3 x){return x-floor(x*(1.0/289.0))*289.0;}
float4 mod289(float4 x){return x-floor(x*(1.0/289.0))*289.0;}
float4 permute(float4 x){return mod289(((x*34.0)+10.0)*x);}
float4 taylorInvSqrt(float4 r){return 1.79284291400159-0.85373472095314*r;}
float snoise(float3 v){
  const float2 C=float2(1.0/6.0,1.0/3.0);
  const float4 D=float4(0.0,0.5,1.0,2.0);
  float3 i=floor(v+dot(v,C.yyy));
  float3 x0=v-i+dot(i,C.xxx);
  float3 g=step(x0.yzx,x0.xyz);
  float3 l=1.0-g;
  float3 i1=min(g.xyz,l.zxy);
  float3 i2=max(g.xyz,l.zxy);
  float3 x1=x0-i1+C.xxx;
  float3 x2=x0-i2+C.yyy;
  float3 x3=x0-D.yyy;
  i=mod289(i);
  float4 p=permute(permute(permute(i.z+float4(0.0,i1.z,i2.z,1.0))+i.y+float4(0.0,i1.y,i2.y,1.0))+i.x+float4(0.0,i1.x,i2.x,1.0));
  float n_=0.142857142857;
  float3 ns=n_*D.wyz-D.xzx;
  float4 j=p-49.0*floor(p*ns.z*ns.z);
  float4 x_=floor(j*ns.z);
  float4 y_=floor(j-7.0*x_);
  float4 x=x_*ns.x+ns.yyyy;
  float4 y=y_*ns.x+ns.yyyy;
  float4 h=1.0-abs(x)-abs(y);
  float4 b0=float4(x.xy,y.xy);
  float4 b1=float4(x.zw,y.zw);
  float4 s0=floor(b0)*2.0+1.0;
  float4 s1=floor(b1)*2.0+1.0;
  float4 sh=-step(h,float4(0,0,0,0));
  float4 a0=b0.xzyw+s0.xzyw*sh.xxyy;
  float4 a1=b1.xzyw+s1.xzyw*sh.zzww;
  float3 p0=float3(a0.xy,h.x);
  float3 p1=float3(a0.zw,h.y);
  float3 p2=float3(a1.xy,h.z);
  float3 p3=float3(a1.zw,h.w);
  float4 norm=taylorInvSqrt(float4(dot(p0,p0),dot(p1,p1),dot(p2,p2),dot(p3,p3)));
  p0*=norm.x;p1*=norm.y;p2*=norm.z;p3*=norm.w;
  float4 m=max(0.5-float4(dot(x0,x0),dot(x1,x1),dot(x2,x2),dot(x3,x3)),0.0);
  m=m*m;
  return 105.0*dot(m*m,float4(dot(p0,x0),dot(p1,x1),dot(p2,x2),dot(p3,x3)));
}
float fbm(float3 p, int oct){
  float a=0.5; float s=0.0; float n=0.0;
  for(int i=0;i<8;i++){ if(i>=oct) break; s+=a*snoise(p); n+=a; p=p*2.03+float3(1.7,9.2,3.1); a*=0.5; }
  return s/n;
}
float ridged(float3 p, int oct){
  float a=0.5; float s=0.0; float n=0.0;
  for(int i=0;i<8;i++){ if(i>=oct) break; s+=a*(1.0-abs(snoise(p))); n+=a; p=p*2.1+float3(3.1,1.3,7.7); a*=0.5; }
  return s/n;
}
float hash13(float3 p){ p=frac(p*0.1031); p+=dot(p,p.zyx+31.32); return frac((p.x+p.y)*p.z); }
float3 hash33(float3 p){ p=frac(p*float3(0.1031,0.1030,0.0973)); p+=dot(p,p.yxz+33.33); return frac((p.xxy+p.yxx)*p.zyx); }
// Point stars on a 3D lattice: each lattice cell near the ray dir*cells may hold a star at a
// random point p inside it; the star is drawn where the view ray passes within its angular
// radius of p. Sizes are in radians so they stay ~1-3 px whatever the lattice density.
float starLayer(float3 dir, float cells, float density, float seed){
  float3 q = dir * cells + seed;
  float3 cell = floor(q);
  float best = 0.0;
  [unroll] for (int z=-1; z<=1; z++) [unroll] for (int y=-1; y<=1; y++) [unroll] for (int x=-1; x<=1; x++) {
    float3 c = cell + float3(x,y,z);
    float3 h = hash33(c);
    if (h.x > density) continue;
    float3 p = c + h - seed;            // star point in the unseeded lattice
    float3 pn = normalize(p);
    float d = length(dir - pn);         // ~ angular distance (radians) for small angles
    float mag = 0.35 + 0.65 * hash13(c + 7.1);
    float rad = 0.0009 + 0.0022 * pow(hash13(c + 3.3), 6.0);
    best = max(best, mag * smoothstep(rad, rad * 0.3, d));
  }
  return best;
}
// Warp streaks: stars streaming outward from the jump point. (ph, th) are the view ray's azimuth
// and polar angle in the warp frame (th = 0 at the jump point); the field is a lattice in that
// space so every streak is exactly radial. flow scrolls the lattice outward (accumulated on the
// CPU so it never runs backwards); len is the streak length in radians, width its angular
// half-width. Streaks are drawn analytically - continuous lines, not strings of samples.
float streakLayer(float ph, float th, float cellsPhi, float cellsTh, float flow, float len, float width, float density, float seed){
  const float PI2 = 6.2831853, PI1 = 3.14159265;
  float u = (ph + PI1) / PI2 * cellsPhi;
  float v = th / PI1 * cellsTh - flow;
  float2 cell = floor(float2(u, v));
  float sth = max(sin(th), 0.02);
  float best = 0.0;
  [unroll] for (int j = 0; j <= 5; j++) [unroll] for (int i = -1; i <= 1; i++) {
    float2 c = cell + float2(i, -j);
    float cx = c.x - cellsPhi * floor(c.x / cellsPhi);
    float3 h = hash33(float3(cx, c.y, seed));
    float ph0 = (c.x + h.y) / cellsPhi * PI2 - PI1;
    float th0 = (c.y + h.z + flow) / cellsTh * PI1;
    // cells shrink toward the poles of the warp frame; thin them so the sky stays even
    if (h.x > density * saturate(sin(th0) + 0.06)) continue;
    float L = len * (0.35 + 0.65 * hash13(float3(cx, c.y, seed + 5.0)));
    float a = th - th0;
    if (a < 0.0 || a > L) continue;
    float dph = ph - ph0; dph -= PI2 * round(dph / PI2);
    float perp = abs(dph) * sth;
    float mag = 0.3 + 0.7 * hash13(float3(cx, c.y, seed + 9.0));
    float wgt = mag * exp(-perp * perp / (width * width));
    wgt *= pow(saturate(a / L), 0.8) * smoothstep(L, L * 0.92, a); // the star leads, its trail fades behind
    best = max(best, wgt);
  }
  return best;
}
// Lensed black hole, drawn in a plane: p in units of the shadow radius (|p| = 1 at the horizon),
// disk horizontal. A thin accretion disk seen almost edge-on: its near side is the bright band
// crossing in front of the shadow, its far side is bent over the top and under the bottom, a
// photon ring hugs the shadow, violet haze around it all. Returns emissive colour (black inside).
float3 blackHole(float2 p, float Time){
  float r = length(p);
  float xa = abs(p.x);
  float hole = smoothstep(1.0, 0.975, r);
  float3 hot = float3(1.0, 0.97, 0.94);
  float3 warm = float3(1.0, 0.55, 0.72);
  float3 violet = float3(0.5, 0.25, 0.95);
  // disk texture: fine streaks slowly orbiting
  float tex = 0.8 + 0.2 * snoise(float3(p.x * 2.5 - Time * 0.3, p.y * 10.0, 3.0));
  tex *= 0.85 + 0.15 * snoise(float3(p.x * 8.0 - Time * 0.8, p.y * 30.0, 9.0));
  float ext = 3.3;                                                   // disk outer edge
  // near side: the band through the centre, slightly below the midline, thinning outward
  float bandT = 0.1 * (1.0 - 0.75 * smoothstep(0.8, ext, xa)) + 0.012;
  float bandF = 1.0 - smoothstep(1.8, ext, xa);
  // a crisp core crosses the shadow; a soft glow sits around it only outside the shadow
  float band = (exp(-pow((p.y + 0.04) / bandT, 2.0)) + 0.2 * exp(-pow((p.y + 0.04) / (bandT * 3.0), 2.0)) * (1.0 - hole)) * bandF;
  // far side bent over the top of the shadow, meeting the band at its sides
  float eTop = sqrt(p.x * p.x / (1.5 * 1.5) + p.y * p.y / (1.55 * 1.55));
  float topT = 0.11 * (1.0 - 0.55 * smoothstep(0.2, 1.4, xa)) + 0.02;
  float arcTop = exp(-pow((eTop - 1.0) * 1.5 / topT, 2.0)) * smoothstep(-0.1, 0.25, p.y);
  // and the thinner, tighter image under it
  float eBot = sqrt(p.x * p.x / (1.35 * 1.35) + p.y * p.y / (0.95 * 0.95));
  float botT = 0.075 * (1.0 - 0.5 * smoothstep(0.2, 1.2, xa)) + 0.015;
  float arcBot = exp(-pow((eBot - 1.0) * 0.95 / botT, 2.0)) * smoothstep(0.1, -0.2, p.y) * 0.9;
  // photon ring
  float pr = exp(-pow((r - 1.025) / 0.03, 2.0)) * 1.2;
  // Doppler beaming: the side swinging toward us burns brighter
  float beam = lerp(1.55, 0.55, smoothstep(-2.0, 2.0, p.x));
  float arcs = (arcTop + arcBot) * tex * beam * (1.0 - hole) + pr;
  float front = band * tex * beam;                                   // passes in front of the shadow
  float disk = arcs + front;
  float3 col = lerp(warm, hot, saturate(disk * 0.8)) * disk * 9.0;
  // haze: violet all round, warm along the disk plane
  float out1 = saturate(1.0 - (r - 1.0) / 3.2);
  float haze = pow(out1, 2.5) * (0.45 + 0.55 * exp(-p.y * p.y * 1.2));
  col += violet * haze * 0.55 * (1.0 - hole);
  col += warm * exp(-p.y * p.y * 6.0) * pow(out1, 3.0) * 0.5 * (1.0 - hole);
  return col;
}
// Ring density profile, t = 0 at the inner edge .. 1 at the outer edge. Shared by the ring
// material and the planet material (ring shadow on the planet). fw = fwidth(t) (0 if unknown):
// the fine bands fade out when they would alias into noise at a distance / grazing angle.
float ringDensity(float t, float Seed, float fw){
  float a160 = saturate(1.0 - fw * 160.0 * 1.5);
  float a700 = saturate(1.0 - fw * 700.0 * 1.5);
  float d = 0.55 + 0.25 * sin(t * 71.0 + Seed) + 0.2 * sin(t * 23.0 + Seed * 2.0);
  d += snoise(float3(t * 160.0, Seed, 0.0)) * 0.25 * a160 + snoise(float3(t * 700.0, Seed * 2.0, 1.0)) * 0.12 * a700;
  d *= smoothstep(0.0, 0.05, t) * smoothstep(1.0, 0.9, t);
  d *= 1.0 - 0.9 * smoothstep(0.022, 0.0, abs(t - 0.63));
  d *= 1.0 - 0.5 * smoothstep(0.012, 0.0, abs(t - 0.31));
  return saturate(d);
}
